# Copia este archivo a ".env" y ajusta los valores según tu instalación de PostgreSQL

# PRODUCCIÓN (Render + Supabase): cadena de conexión del "Session pooler" de Supabase
# (Project -> Connect). Si la defines, se ignoran las variables DB_* de abajo. Déjala vacía en local.
# Formato: postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
GOOGLE_CLIENT_ID=
DATABASE_URL=

# Solo local (se ignoran si DATABASE_URL tiene valor)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bakinghub
DB_HOST=localhost
DB_PORT=5432
PORT=4000

# En producción (Render) debe ser production. Con production, MP_MODO=simulado se rechaza.
# NODE_ENV=production

# Secreto para firmar los JWT (mínimo 32 caracteres, obligatorio). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opcional: la cuenta con este correo obtiene rol "admin" al registrarse o al iniciar el backend.
# Cambia el valor en tu archivo .env local; no pongas aquí tu correo real.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------------------
# Pagos con Mercado Pago (tarjeta, OXXO, SPEI y billetera). La integración ya está hecha en pagos.js.
# ---------------------------------------------------------------------------------------
# simulado = NO llama a Mercado Pago (sirve para probar todas las pantallas del checkout).
# real     = cobra con tu cuenta de Mercado Pago (configura las credenciales reales).
# Con NODE_ENV=production el modo simulado se rechaza (cualquiera podría "simular" que pagó).
MP_MODO=simulado

# Métodos que aparecen en el checkout (quita los que no quieras): tarjeta, oxxo, spei, mercadopago
MP_METODOS=tarjeta,oxxo,spei,mercadopago

# Horas que tiene el cliente para pagar en OXXO / SPEI antes de que el pedido expire y se libere el stock
PEDIDO_EXPIRA_HORAS=72

# Máximo de pedidos pendientes de pago por cliente a la vez (evita que alguien aparte todo el inventario)
MAX_PEDIDOS_PENDIENTES=5

# Solo para MP_MODO=real:
# Access Token PRIVADO: de "Credenciales de prueba" para probar, de "Credenciales de producción" para cobrar. Nunca lo subas a git.
MP_ACCESS_TOKEN=
# Pon true si tus credenciales son de PRUEBA pero empiezan con APP_USR- (así las entrega hoy Mercado Pago en
# "Pruebas -> Credenciales de prueba"). Con tokens que empiezan con TEST- no hace falta. Con credenciales de producción, déjalo vacío.
MP_CREDENCIALES_PRUEBA=
# OPCIONAL, solo con credenciales de prueba: correo de una cuenta compradora de prueba. Si lo dejas vacío se usa el correo
# del cliente (así funciona el proyecto de referencia). Defínelo solo si Mercado Pago rechaza el pago por el comprador.
MP_TEST_PAYER_EMAIL=
# Clave secreta del webhook (Tus integraciones -> Webhooks -> Configurar notificaciones). Obligatoria si pones BACKEND_PUBLIC_URL.
# En el panel suscribe el evento "Order (Mercado Pago)" y apunta la URL a <BACKEND_PUBLIC_URL>/webhooks/mercadopago.
MP_WEBHOOK_SECRET=
# URL pública https de este backend para los avisos (webhook). En desarrollo usa ngrok o cloudflared, p. ej. https://abc123.ngrok.app
# Opcional: si la dejas vacía, los pagos se confirman igual por consulta periódica a Mercado Pago (cada 5 min).
BACKEND_PUBLIC_URL=
# URL del frontend; usa la URL HTTPS pública (por ejemplo, ngrok) para volver después del pago.
# Con localhost se omite el retorno automático de Mercado Pago.
FRONTEND_URL=http://localhost:4321
