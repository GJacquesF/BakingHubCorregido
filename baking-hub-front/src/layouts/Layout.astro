---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import PresenciaUsuario from '../components/PresenciaUsuario';
import { messages } from '../i18n/messages';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagenSocial?: string;
  imagenLcp?: string;
  /** Muestra la barra lateral de categorías (páginas de tienda). */
  sidebar?: boolean;
  categoriaActiva?: string;
}

const { titulo, descripcion, imagenSocial, imagenLcp, sidebar = false, categoriaActiva } = Astro.props;
const title = titulo ? `${titulo} · Baking Hub` : 'Baking Hub';
const description = descripcion ?? 'Descubre postres artesanales recién horneados en Baking Hub. Elige tus favoritos y recíbelos en tu punto de entrega.';
const locale = Astro.currentLocale ?? 'es';
const defaultPathname = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const canonicalPathname = locale === 'en'
  ? `/en${defaultPathname === '/' ? '' : defaultPathname}`
  : defaultPathname;
const canonical = new URL(canonicalPathname, Astro.url.origin);
const alternateEs = new URL(defaultPathname, Astro.url.origin);
const alternateEn = new URL(`/en${defaultPathname === '/' ? '' : defaultPathname}`, Astro.url.origin);
const socialImage = imagenSocial ? new URL(imagenSocial, Astro.url.origin) : new URL('/favicon.svg', Astro.url.origin);
---

<!doctype html>
<html lang={locale} data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#dca17d" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={alternateEs.href} />
    <link rel="alternate" hreflang="en" href={alternateEn.href} />
    <link rel="alternate" hreflang="x-default" href={alternateEs.href} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Baking Hub" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imagenLcp && <link rel="preload" as="image" href={imagenLcp} fetchpriority="high" />}
    <script is:inline define:vars={{ translations: messages }}>
      let redirectingToEnglish = false;
      try {
        redirectingToEnglish = location.pathname === '/' && localStorage.getItem('baking-hub-locale') === 'en';
      } catch {}
      if (redirectingToEnglish) location.replace(`/en/${location.search}${location.hash}`);

      const currentLocale = redirectingToEnglish || document.documentElement.dataset.locale === 'en' ? 'en' : 'es';
      try {
        localStorage.setItem('baking-hub-locale', currentLocale);
      } catch {}
      document.cookie = `baking-hub-locale=${currentLocale}; Path=/; Max-Age=31536000; SameSite=Lax${location.protocol === 'https:' ? '; Secure' : ''}`;

      const applyStoredTheme = (theme) => {
        document.documentElement.dataset.theme = theme;
        document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
          button.setAttribute('aria-pressed', String(theme === 'dark'));
        });
      };

      try {
        const theme = localStorage.getItem('baking-hub-theme');
        if (theme === 'light' || theme === 'dark') applyStoredTheme(theme);
      } catch {}

      document.addEventListener('click', (event) => {
        const target = event.target;
        const button = target instanceof Element ? target.closest('[data-theme-toggle]') : null;
        if (!button) return;

        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        applyStoredTheme(theme);
        try {
          localStorage.setItem('baking-hub-theme', theme);
        } catch {}
      });

      document.addEventListener('DOMContentLoaded', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
          button.setAttribute('aria-pressed', String(theme === 'dark'));
        });
      });

      const applyTranslation = (element) => {
        if (!(element instanceof HTMLElement)) return;
        const key = element.dataset.i18n;
        if (!key) return;
        const locale = document.documentElement.dataset.locale || 'es';
        const parts = key.split('.');
        let lookup = parts.reduce((acc, part) => acc?.[part], translations[locale]);
        if (typeof lookup !== 'string') return;

        const params = element.dataset.i18nParams ? JSON.parse(element.dataset.i18nParams) : {};
        if (params && Object.keys(params).length > 0) {
          lookup = lookup.replace(/\{(\w+)\}/g, (_, name) => String(params[name] ?? ''));
        }

        if (element.dataset.i18nName) {
          lookup = `${lookup}, ${element.dataset.i18nName}`;
        }

        if (element instanceof HTMLInputElement && (element.type === 'submit' || element.type === 'button')) {
          element.value = lookup;
          return;
        }

        if (element.tagName === 'OPTION') {
          element.textContent = lookup;
          return;
        }

        element.textContent = lookup;
      };

      const applyTranslations = () => {
        document.querySelectorAll('[data-i18n]').forEach(applyTranslation);
      };

      const updateOfflineStatus = () => {
        const offlineStatus = document.getElementById('offline-status');
        if (!offlineStatus) return;
        offlineStatus.hidden = navigator.onLine;
        offlineStatus.textContent = translations[locale].offlineStatus;
      };
      window.addEventListener('online', updateOfflineStatus);
      window.addEventListener('offline', updateOfflineStatus);
      document.addEventListener('DOMContentLoaded', () => {
        applyTranslations();
        updateOfflineStatus();
      });

      document.addEventListener('change', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const select = target ? target.closest('[data-locale-switch]') : null;
        if (!select) return;

        const nextLocale = select.value === 'en' ? 'en' : 'es';
        try {
          localStorage.setItem('baking-hub-locale', nextLocale);
        } catch {}
        document.cookie = `baking-hub-locale=${nextLocale}; Path=/; Max-Age=31536000; SameSite=Lax${location.protocol === 'https:' ? '; Secure' : ''}`;
        const defaultPath = location.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
        const localizedPath = nextLocale === 'en'
          ? `/en${defaultPath === '/' ? '' : defaultPath}`
          : defaultPath;
        location.assign(`${localizedPath}${location.search}${location.hash}`);
      });

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          const isSecure = location.protocol === 'https:' || ['localhost', '127.0.0.1'].includes(location.hostname);
          if (!isSecure) return;
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch((error) => {
            console.error('No se pudo registrar el service worker de Baking Hub:', error);
          });
        });
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <p id="offline-status" class="offline-status" role="status" aria-live="polite" hidden></p>
    {Astro.locals.usuario?.rol === 'cliente' && <PresenciaUsuario client:load />}
    <div class="layout-principal">
      <Header />
      <div class="contenedor-central">
        {sidebar && <Sidebar activa={categoriaActiva} />}
        <main class:list={['main-content', { 'sin-sidebar': !sidebar }]}>
          <slot />
        </main>
      </div>
      <Footer />
    </div>
  </body>
</html>

<style>
  .layout-principal {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    background: radial-gradient(circle at top, rgba(255,255,255,0.08), transparent 38%);
  }

  .offline-status {
    position: sticky;
    top: 0;
    z-index: 20;
    margin: 0;
    padding: 0.65rem 1rem;
    background: var(--warning-surface);
    color: var(--warning-text);
    text-align: center;
  }

  .contenedor-central {
    display: flex;
    flex: 1;
    max-width: 1220px;
    width: min(1220px, calc(100% - 2rem));
    margin: 0 auto;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .main-content {
    flex: 1;
    padding: 2rem 0 2.5rem;
    max-width: 1100px;
  }

  .main-content.sin-sidebar {
    width: 100%;
    margin-inline: auto;
  }

  @media (max-width: 768px) {
    .contenedor-central { flex-direction: column; width: min(100% - 1rem, 1220px); gap: 1rem; }
    .main-content { padding: 1rem 0 2rem; }
  }
</style>
