---
import Layout from './Layout.astro';
import AdminNav from '../components/AdminNav.astro';
import '../styles/admin.css';

interface Props {
  titulo: string;
  seccion: 'resumen' | 'pedidos' | 'inventario' | 'entregas' | 'usuarios';
}

const { titulo, seccion } = Astro.props;
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const titulosEn: Record<Props['seccion'], string> = {
  resumen: 'Summary',
  pedidos: 'Orders',
  inventario: 'Inventory',
  entregas: 'Deliveries',
  usuarios: 'Customers',
};
---

<Layout titulo={`Admin · ${locale === 'en' ? titulosEn[seccion] : titulo}`}>
  <AdminNav activa={seccion} />
  <slot />
</Layout>

<script>
  // Formularios con data-confirmar="¿Seguro…?" piden confirmación antes de enviarse.
  document.addEventListener('submit', (evento) => {
    const formulario = evento.target as HTMLFormElement;
    const mensaje = formulario.dataset?.confirmar;
    if (mensaje && !confirm(mensaje)) evento.preventDefault();
  });
</script>
