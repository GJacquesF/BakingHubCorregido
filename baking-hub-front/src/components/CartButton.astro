---
import { totalArticulos } from '../stores/carrito';
import { localizedPath, localizedText } from '../lib/i18n';

const cantidad = totalArticulos.get();
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const label = localizedText(locale, 'Carrito');
---

<a class="cart-button" href={localizedPath(locale, '/carrito')} aria-live="polite" aria-atomic="true" aria-label={localizedText(locale, 'Carrito, {count} artículos', { count: cantidad })}>
  <span data-i18n="cart.label">{label}</span> (<span data-cart-count>{cantidad}</span>)
</a>

<script>
  import { localizedText } from '../i18n/messages';
  import { totalArticulos } from '../stores/carrito';

  totalArticulos.subscribe((cantidad) => {
    document.querySelectorAll<HTMLAnchorElement>('.cart-button[data-cart-count], a.cart-button').forEach((enlace) => {
      const contador = enlace.querySelector('[data-cart-count]');
      const labelNode = enlace.querySelector('[data-i18n="cart.label"]');
      if (contador) contador.textContent = String(cantidad);

      const locale = document.documentElement.dataset.locale === 'en' ? 'en' : 'es';
      const label = localizedText(locale, 'Carrito');
      if (labelNode) labelNode.textContent = label;
      enlace.setAttribute('aria-label', localizedText(locale, 'Carrito, {count} artículos', { count: cantidad }));
    });
  });
</script>