---
import AddToCartButton from './AddToCartButton';
import { precio } from '../lib/format';
import type { Producto } from '../types';

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const productUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const productJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: producto.nombre,
  image: [producto.imagen],
  description: `${producto.nombre}, postre artesanal de Baking Hub.`,
  sku: producto.id,
  offers: {
    '@type': 'Offer',
    url: productUrl,
    priceCurrency: 'MXN',
    price: producto.precio,
    availability: producto.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  },
}).replace(/</g, '\\u003c');
---

<script type="application/ld+json" set:html={productJsonLd} />
<div class="detalle-card">
  <a class="volver-btn" href="/" data-i18n="product.backCatalog">← Volver al catálogo</a>
  <h1>{producto.nombre}</h1>
  <img src={producto.imagen} alt={producto.nombre} width="720" height="480" loading="eager" fetchpriority="high" />
  <p class="detalle-precio" data-i18n="product.price">Precio: {precio(producto.precio)}</p>
  {producto.stock <= 0 && <p class="existencia agotado" data-i18n="product.outOfStock">Producto agotado por ahora</p>}
  {producto.stock > 0 && producto.stock <= 5 && (
    <p class="existencia pocas" data-i18n="product.fewLeft" data-i18n-params={JSON.stringify({ count: producto.stock })}>
      ¡Solo quedan {producto.stock} piezas!
    </p>
  )}
  <AddToCartButton client:only="react" producto={producto}>
    <button slot="fallback" class="btn-primario" disabled data-i18n="product.addToCart">Añadir al carrito</button>
  </AddToCartButton>
</div>

<style>
  .detalle-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.75rem;
    max-width: 460px;
  }

  .volver-btn {
    display: inline-block;
    color: var(--espresso-soft);
    font-weight: 500;
    padding: 0.4rem 0;
    margin-bottom: 1rem;
    text-decoration: none;
  }

  .volver-btn:hover { color: var(--espresso); }

  h1 {
    font-style: italic;
    color: var(--honey-dark);
    font-size: 1.8rem;
  }

  img {
    width: 100%;
    max-height: 260px;
    object-fit: cover;
    border-radius: 8px;
    margin: 1.1rem 0;
  }

  .detalle-precio {
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 1.1rem;
  }

  .existencia {
    margin: -0.5rem 0 1.1rem;
    font-weight: 600;
  }

  .existencia.agotado { color: var(--jam); }
  .existencia.pocas { color: var(--honey-dark); }
</style>
