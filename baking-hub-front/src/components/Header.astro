---
import CartButton from './CartButton.astro';
import InstallPWAButton from './InstallPWAButton';
import { localizedPath } from '../lib/i18n';

const { usuario } = Astro.locals;
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const primerNombre = usuario?.nombre.split(' ')[0];
const strings = {
  es: {
    nav: 'Cuenta y carrito',
    admin: 'Panel admin',
    pedidos: 'Mis pedidos',
    hola: 'Hola',
    salir: 'Salir',
    ingresar: 'Ingresar',
    registro: 'Crear cuenta',
    idioma: 'Idioma',
    theme: 'Modo oscuro',
    dark: 'Oscuro',
  },
  en: {
    nav: 'Account and cart',
    admin: 'Admin panel',
    pedidos: 'My orders',
    hola: 'Hi',
    salir: 'Log out',
    ingresar: 'Sign in',
    registro: 'Create account',
    idioma: 'Language',
    theme: 'Dark mode',
    dark: 'Dark',
  },
};
const t = strings[locale];
---

<header class="top-bar">
  <a class="brand" href={localizedPath(locale, '/')}>Baking Hub</a>

  <nav class="acciones" aria-label={t.nav}>
    {
      usuario ? (
        <>
          {usuario.rol === 'admin' && <a class="enlace enlace-admin" href={localizedPath(locale, '/admin')} data-i18n="header.admin">{t.admin}</a>}
          <a class="enlace" href={localizedPath(locale, '/pedidos')} data-i18n="header.pedidos">{t.pedidos}</a>
          <span class="saludo" data-i18n="header.hola" data-i18n-name={primerNombre}>{t.hola}, {primerNombre}</span>
          <form method="POST" action={`/api/auth/logout?locale=${locale}`}>
            <button class="enlace enlace-btn" type="submit" data-i18n="header.salir">{t.salir}</button>
          </form>
        </>
      ) : (
        <>
          <a class="enlace" href={localizedPath(locale, '/login')} data-i18n="header.ingresar">{t.ingresar}</a>
          <a class="enlace" href={localizedPath(locale, '/registro')} data-i18n="header.registro">{t.registro}</a>
        </>
      )
    }
    <label class="locale-picker" aria-label={t.idioma}>
      <span class="sr-only" data-i18n="header.idioma">{t.idioma}</span>
      <select data-locale-switch aria-label={t.idioma}>
        <option value="es" selected={locale === 'es'}>ES</option>
        <option value="en" selected={locale === 'en'}>EN</option>
      </select>
    </label>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label={t.theme} aria-pressed="false" title={t.theme}>
      <span data-i18n="header.dark">{t.dark}</span>
      <span class="theme-switch" aria-hidden="true"><span></span></span>
    </button>
    <InstallPWAButton client:load />
    <CartButton />
  </nav>
</header>

<style>
  .top-bar {
    width: min(1220px, calc(100% - 2rem));
    margin: 1.25rem auto 0;
    background: var(--header-surface);
    color: var(--text);
    padding: 1rem 1.4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    border-radius: 28px;
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--line);
    position: sticky;
    top: 0.7rem;
    z-index: 10;
    backdrop-filter: blur(8px);
  }

  .brand {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 500;
    font-size: 1.6rem;
    color: var(--text);
    text-decoration: none;
    letter-spacing: 0.2px;
    white-space: nowrap;
  }

  .acciones {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .acciones form { margin: 0; }

  .locale-picker {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    padding: 0.12rem 0.6rem;
  }

  .locale-picker select {
    background: transparent;
    border: 0;
    color: var(--text);
    font: 600 0.82rem/1 var(--font-body);
    padding: 0.38rem 0.2rem;
    border-radius: 999px;
    outline: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.42rem 0.62rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font: 600 0.82rem/1 var(--font-body);
  }

  .theme-switch {
    display: inline-flex;
    align-items: center;
    width: 2rem;
    height: 1.15rem;
    padding: 0.15rem;
    border-radius: 999px;
    background: var(--surface-2);
    box-shadow: var(--shadow-inset);
    transition: background 0.2s ease;
  }

  .theme-switch > span {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--primary-strong);
    transition: transform 0.2s ease;
  }

  .theme-toggle[aria-pressed='true'] .theme-switch { background: var(--primary-strong); }
  .theme-toggle[aria-pressed='true'] .theme-switch > span { transform: translateX(0.85rem); background: #fff8f1; }
  .theme-toggle:hover { border-color: var(--primary-strong); }

  .enlace {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .enlace:hover { color: var(--primary-strong); }

  .enlace-admin { color: var(--primary-strong); font-weight: 600; }

  .enlace-btn {
    background: none;
    padding: 0;
    font-size: 0.95rem;
  }

  .saludo {
    color: var(--text);
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .top-bar { width: min(100% - 1rem, 1220px); padding: 0.9rem 1.1rem; }
  }

  @media (max-width: 520px) {
    .top-bar { flex-wrap: wrap; justify-content: flex-start; gap: 0.7rem; }
    .brand { font-size: 1.45rem; }
    .acciones { flex: 1 1 100%; justify-content: flex-start; gap: 0.65rem 0.85rem; }
    .locale-picker { order: 1; }
    .theme-toggle { order: 2; }
  }
</style>
