---
interface Props {
  titulo: string;
  tituloKey?: string;
  subtitulo?: string;
  subtituloKey?: string;
}

const { titulo, tituloKey, subtitulo, subtituloKey } = Astro.props;
---

<section class="auth-card">
  <h2 data-i18n={tituloKey}>{titulo}</h2>
  {subtitulo && <p class="subtitulo" data-i18n={subtituloKey}>{subtitulo}</p>}
  <slot />
  <p class="pie"><slot name="pie" /></p>
</section>

<style>
  .auth-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem;
    max-width: 420px;
    margin: 1rem auto;
  }

  h2 {
    font-style: italic;
    font-weight: 500;
    font-size: 1.8rem;
  }

  .subtitulo {
    margin: 0.4rem 0 1.5rem;
    color: var(--espresso-soft);
  }

  .pie {
    margin: 1.25rem 0 0;
    text-align: center;
    color: var(--espresso-soft);
    font-size: 0.95rem;
  }

  .pie :global(a) {
    color: var(--honey-dark);
    font-weight: 600;
  }
</style>
