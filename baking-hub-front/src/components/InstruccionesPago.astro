---
import { precio } from '../lib/format';
import { messages } from '../i18n/messages';
import { formatearFecha, formatearReferencia } from '../lib/pagos';
import type { Pedido } from '../types';

interface Props {
  pedido: Pedido;
}

const { pedido } = Astro.props;
const esOxxo = pedido.metodoPago === 'oxxo';
const esSpei = pedido.metodoPago === 'spei';
const esBilletera = pedido.metodoPago === 'mercadopago';
const locale = Astro.locals.locale;
const texto = messages[locale].paymentInstructions;
// Solo se enlaza a Mercado Pago por https.
const enlace = pedido.pagoUrl?.startsWith('https://') ? pedido.pagoUrl : null;
---

{
  (esOxxo || esSpei) && (
    <section class="ficha" aria-label={esOxxo ? texto.oxxo : texto.spei}>
      <h3>{esOxxo ? texto.oxxo : texto.spei}</h3>

      <dl>
        <div>
          <dt>{esOxxo ? texto.paymentReference : texto.clabe}</dt>
          <dd class="referencia" id="referencia-pago">
            {pedido.pagoReferencia ? formatearReferencia(pedido.pagoReferencia) : texto.pending}
          </dd>
        </div>
        <div>
          <dt>{texto.exactAmount}</dt>
          <dd class="monto">{precio(pedido.total)}</dd>
        </div>
        {
          pedido.pagoExpira && (
            <div>
              <dt>{texto.payBefore}</dt>
              <dd>{formatearFecha(pedido.pagoExpira, locale)}</dd>
            </div>
          )
        }
      </dl>

      {
        pedido.pagoReferencia && (
          <button class="copiar" type="button" data-copiar={pedido.pagoReferencia}>
            {texto.copy} {esOxxo ? texto.reference : 'CLABE'}
          </button>
        )
      }

      <ol>
        {
          esOxxo ? (
            <>
              <li>{texto.oxxoStep1}</li>
              <li>{texto.oxxoStep2}</li>
              <li>{texto.oxxoStep3}</li>
            </>
          ) : (
            <>
              <li>{texto.speiStep1}</li>
              <li>{texto.speiStep2}</li>
              <li>{texto.speiStep3}</li>
            </>
          )
        }
      </ol>

      {
        enlace && (
          <a class="enlace-ficha" href={enlace} target="_blank" rel="noopener noreferrer">
            {texto.viewSlip}
          </a>
        )
      }
    </section>
  )
}

{
  esBilletera && (
    <section class="ficha" aria-label={texto.payment}>
      <h3>{texto.complete}</h3>
      <p>{texto.reserved}</p>
      {enlace && (
        <a class="btn-primario enlace-btn" href={enlace}>
          {texto.goTo}
        </a>
      )}
    </section>
  )
}

<script>
  import { localizedText } from '../i18n/messages';

  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((boton) => {
    boton.addEventListener('click', async () => {
      const original = boton.textContent;
      try {
        await navigator.clipboard.writeText(boton.dataset.copiar ?? '');
        const locale = document.documentElement.dataset.locale === 'en' ? 'en' : 'es';
        boton.textContent = localizedText(locale, '¡Copiado!');
      } catch {
        const locale = document.documentElement.dataset.locale === 'en' ? 'en' : 'es';
        boton.textContent = localizedText(locale, 'No se pudo copiar');
      }
      setTimeout(() => (boton.textContent = original), 1800);
    });
  });
</script>

<style>
  .ficha {
    background: var(--panel);
    border: 1px dashed var(--honey-dark);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem;
    margin: 1.25rem 0;
  }

  h3 { font-size: 1.2rem; margin-bottom: 1rem; }

  dl { margin: 0 0 1rem; display: grid; gap: 0.9rem; }

  dt { font-size: 0.85rem; color: var(--espresso-soft); }

  dd { margin: 0.15rem 0 0; font-weight: 600; }

  .referencia {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 1.5rem;
    letter-spacing: 0.06em;
    word-break: break-all;
  }

  .monto { font-size: 1.3rem; color: var(--honey-dark); }

  .copiar {
    background: var(--espresso);
    color: var(--cream);
    padding: 0.55rem 1rem;
    border-radius: 8px;
    font-weight: 500;
    margin-bottom: 1.1rem;
  }

  .copiar:hover { background: var(--honey-dark); }

  ol { margin: 0 0 1rem; padding-left: 1.25rem; color: var(--espresso-soft); display: flex; flex-direction: column; gap: 0.35rem; }

  .enlace-ficha { color: var(--honey-dark); font-weight: 600; }

  .enlace-btn { max-width: 280px; }
</style>
