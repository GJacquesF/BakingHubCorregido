---
import { precio } from '../lib/format';
import { estadoPedido, formatearFecha, metodoPago } from '../lib/pagos';
import { localizedPath } from '../lib/i18n';
import type { Pedido } from '../types';

interface Props {
  pedido: Pedido;
  destacado?: boolean;
}

const { pedido, destacado = false } = Astro.props;
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const fecha = formatearFecha(pedido.fecha, locale);
const estado = estadoPedido(pedido.status, locale);
const metodo = pedido.metodoPago ? metodoPago(pedido.metodoPago, locale) : null;
const porPagar = pedido.status === 'pendiente' && pedido.metodoPago !== null;
const detalles = localizedPath(locale, `/pedidos/${pedido.id}`);
---

<article class:list={['pedido', { destacado }]}>
  <header>
    <h3><a href={detalles}>{locale === 'en' ? `Order #${pedido.id}` : `Pedido #${pedido.id}`}</a></h3>
    <span class={`badge badge-${estado.clase}`}>{estado.etiqueta}</span>
  </header>
  <p class="fecha">{fecha}{metodo && ` · ${metodo.etiqueta}`}</p>
  <ul>
    {
      pedido.productos.map((p) => (
        <li>
          <span>{p.cantidad} × {p.nombre}</span>
          <span>{precio(p.precio * p.cantidad)}</span>
        </li>
      ))
    }
  </ul>
  <p class="total">Total: <strong>{precio(pedido.total)}</strong></p>
  <p class="acciones">
    <a href={detalles}>
      {porPagar
        ? locale === 'en' ? 'View payment instructions →' : 'Ver instrucciones de pago →'
        : locale === 'en' ? 'View details →' : 'Ver detalle →'}
    </a>
  </p>
</article>

<style>
  .pedido {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    max-width: 560px;
  }

  .pedido.destacado { border-color: var(--honey); }

  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  h3 { font-size: 1.1rem; }

  h3 a { text-decoration: none; }
  h3 a:hover { color: var(--honey-dark); }

  .acciones {
    margin: 0.6rem 0 0;
    text-align: right;
    font-size: 0.92rem;
  }

  .acciones a { color: var(--honey-dark); font-weight: 600; text-decoration: none; }
  .acciones a:hover { text-decoration: underline; }

  .fecha {
    margin: 0.2rem 0 0.8rem;
    color: var(--espresso-soft);
    font-size: 0.9rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--line);
  }

  .total { margin: 0.8rem 0 0; text-align: right; }
</style>
