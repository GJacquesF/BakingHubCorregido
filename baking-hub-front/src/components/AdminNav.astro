---
interface Props {
  activa: 'resumen' | 'pedidos' | 'inventario' | 'entregas' | 'usuarios';
}

import { localizedPath } from '../lib/i18n';

const { activa } = Astro.props;
const enlaces = [
  { clave: 'resumen', path: '/admin', texto: 'Resumen', textoEn: 'Summary' },
  { clave: 'pedidos', path: '/admin/pedidos', texto: 'Pedidos', textoEn: 'Orders' },
  { clave: 'inventario', path: '/admin/inventario', texto: 'Inventario', textoEn: 'Inventory' },
  { clave: 'entregas', path: '/admin/entregas', texto: 'Entregas', textoEn: 'Deliveries' },
  { clave: 'usuarios', path: '/admin/usuarios', texto: 'Clientes', textoEn: 'Customers' },
] as const;
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
---

<nav class="admin-nav" aria-label={locale === 'en' ? 'Administration panel' : 'Panel de administración'}>
  <span class="admin-nav-titulo">{locale === 'en' ? 'Admin panel' : 'Panel admin'}</span>
  {
    enlaces.map((e) => (
      <a href={localizedPath(locale, e.path)} class:list={['admin-enlace', { activa: activa === e.clave }]} aria-current={activa === e.clave ? 'page' : undefined}>
        {locale === 'en' ? e.textoEn : e.texto}
      </a>
    ))
  }
</nav>

<style>
  .admin-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .admin-nav-titulo {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 1.3rem;
    margin-right: 1rem;
    color: var(--honey-dark);
  }

  .admin-enlace {
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--espresso-soft);
    font-weight: 500;
  }

  .admin-enlace:hover { background: var(--surface); }

  .admin-enlace.activa {
    background: var(--honey);
    color: var(--espresso);
    font-weight: 600;
  }
</style>
