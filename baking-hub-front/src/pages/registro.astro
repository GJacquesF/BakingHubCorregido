---
import Layout from '../layouts/Layout.astro';
import AuthCard from '../components/AuthCard.astro';
import FormField from '../components/FormField.astro';
import Alert from '../components/Alert.astro';
import GoogleSignIn from '../components/GoogleSignIn';
import { graphql, ApiError } from '../lib/graphql';
import { REGISTRAR } from '../lib/queries';
import { rutaSegura } from '../lib/auth';

const next = rutaSegura(Astro.url.searchParams.get('next'));
if (Astro.locals.usuario) return Astro.redirect(next);

let error: string | null = null;
let mensaje: string | null = null;
let nombre = '';
let email = (Astro.url.searchParams.get('email') ?? '').trim();
let registroExitoso = false;

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  email = String(datos.get('email') ?? '').trim();
  nombre = String(datos.get('nombre') ?? '').trim();
  const password = String(datos.get('password') ?? '');
  const confirmar = String(datos.get('confirmar') ?? '');

  if (password !== confirmar) {
    error = 'Las contraseñas no coinciden.';
  } else {
    try {
      await graphql<{ registrar: { mensaje: string } }>(REGISTRAR, { nombre, email, password });
      registroExitoso = true;
      mensaje = 'Cuenta creada. Ya puedes iniciar sesión.';
    } catch (e) {
      error =
        e instanceof ApiError && e.codigo === 'BAD_USER_INPUT'
          ? e.message
          : 'No pudimos crear tu cuenta. Inténtalo de nuevo en un momento.';
    }
  }
}
---

<Layout titulo="Crear cuenta">
  <AuthCard
    titulo="Crear cuenta"
    subtitulo="Con tu cuenta puedes pagar y ver tus pedidos anteriores."
  >
    {error && <Alert>{error}</Alert>}
    {mensaje && <p role="status">{mensaje}</p>}
    {registroExitoso ? (
      <p><a href={`/login${next !== '/' ? `?next=${encodeURIComponent(next)}` : ''}`}>Ir a iniciar sesión</a></p>
    ) : (
      <>
        <form method="POST">
          <FormField label="Nombre" name="nombre" autocomplete="name" value={nombre} minlength={2} />
          <FormField label="Correo" name="email" type="email" autocomplete="email" value={email} />
          <FormField label="Contraseña (mínimo 8 caracteres)" name="password" type="password" autocomplete="new-password" minlength={8} />
          <FormField label="Repite la contraseña" name="confirmar" type="password" autocomplete="new-password" minlength={8} />
          <button class="btn-primario" type="submit">Crear cuenta</button>
        </form>
        <p class="separador-auth">O continúa con</p>
        <GoogleSignIn client:load clientId={import.meta.env.PUBLIC_GOOGLE_CLIENT_ID} next={next} />
      </>
    )}
    <Fragment slot="pie">
      ¿Ya tienes cuenta? <a href={`/login${next !== '/' ? `?next=${encodeURIComponent(next)}` : ''}`}>Ingresar</a>
    </Fragment>
  </AuthCard>
</Layout>

<style>
  .separador-auth {
    margin: 1.25rem 0 0;
    text-align: center;
    color: var(--espresso-soft);
  }
</style>
