---
import Layout from '../layouts/Layout.astro';
import AuthCard from '../components/AuthCard.astro';
import FormField from '../components/FormField.astro';
import Alert from '../components/Alert.astro';
import GoogleSignIn from '../components/GoogleSignIn';
import { graphql, ApiError } from '../lib/graphql';
import { REGISTRAR } from '../lib/queries';
import { rutaSegura } from '../lib/auth';

const next = rutaSegura(Astro.url.searchParams.get('next'));
if (Astro.locals.usuario) return Astro.redirect(next);

let error: string | null = null;
let mensaje: string | null = null;
let nombre = '';
let email = (Astro.url.searchParams.get('email') ?? '').trim();
let registroExitoso = false;

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  email = String(datos.get('email') ?? '').trim();
  nombre = String(datos.get('nombre') ?? '').trim();
  const password = String(datos.get('password') ?? '');
  const confirmar = String(datos.get('confirmar') ?? '');
  const turnstileEnabled = Boolean(import.meta.env.PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY);
  const turnstileToken = String(datos.get('cf-turnstile-response') ?? '').trim();
  const humanCheck = String(datos.get('turnstile-human') ?? '') === 'on';

  if (turnstileEnabled && !turnstileToken) {
    error = 'Completa la verificación de seguridad antes de crear la cuenta.';
  } else if (!turnstileEnabled && !humanCheck) {
    error = 'Marca la casilla para confirmar que eres humano.';
  } else if (password !== confirmar) {
    error = 'Las contraseñas no coinciden.';
  } else {
    try {
      await graphql<{ registrar: { mensaje: string } }>(REGISTRAR, {
        nombre,
        email,
        password,
        turnstileToken: turnstileEnabled ? turnstileToken : humanCheck ? 'manual-human-check' : null,
      });
      registroExitoso = true;
      mensaje = 'Cuenta creada. Ya puedes iniciar sesión.';
    } catch (e) {
      error =
        e instanceof ApiError && e.codigo === 'BAD_USER_INPUT'
          ? e.message
          : 'No pudimos crear tu cuenta. Inténtalo de nuevo en un momento.';
    }
  }
}
---

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<Layout titulo="Crear cuenta">
  <AuthCard
    titulo="Crear cuenta"
    subtitulo="Con tu cuenta puedes pagar y ver tus pedidos anteriores."
  >
    {error && <Alert>{error}</Alert>}
    {mensaje && <p role="status">{mensaje}</p>}
    {registroExitoso ? (
      <p><a href={`/login${next !== '/' ? `?next=${encodeURIComponent(next)}` : ''}`}>Ir a iniciar sesión</a></p>
    ) : (
      <>
        <form method="POST">
          <FormField label="Nombre" name="nombre" autocomplete="name" value={nombre} minlength={2} />
          <FormField label="Correo" name="email" type="email" autocomplete="email" value={email} />
          <FormField label="Contraseña (mínimo 8 caracteres)" name="password" type="password" autocomplete="new-password" minlength={8} />
          <FormField label="Repite la contraseña" name="confirmar" type="password" autocomplete="new-password" minlength={8} />
          {import.meta.env.PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY ? (
            <div class="turnstile-wrap">
              <div
                class="cf-turnstile"
                data-sitekey={import.meta.env.PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY}
                data-theme="light"
                data-size="normal"
              />
            </div>
          ) : (
            <label class="human-check">
              <input type="checkbox" name="turnstile-human" />
              <span>Confirmo que soy humano</span>
            </label>
          )}
          <button class="btn-primario" type="submit">Crear cuenta</button>
        </form>
        <p class="separador-auth">O continúa con</p>
        <GoogleSignIn client:load clientId={import.meta.env.PUBLIC_GOOGLE_CLIENT_ID} next={next} />
      </>
    )}
    <Fragment slot="pie">
      ¿Ya tienes cuenta? <a href={`/login${next !== '/' ? `?next=${encodeURIComponent(next)}` : ''}`}>Ingresar</a>
    </Fragment>
  </AuthCard>
</Layout>

<style>
  .separador-auth {
    margin: 1.25rem 0 0;
    text-align: center;
    color: var(--espresso-soft);
  }

  .turnstile-wrap {
    display: flex;
    justify-content: center;
    margin: 1rem 0 0.5rem;
  }

  .human-check {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 1rem 0 0.85rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--espresso-soft);
    font-size: 0.95rem;
  }

  .human-check input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--melon);
  }
</style>
