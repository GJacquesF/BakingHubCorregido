---
import RegistrationPage from '../components/RegistrationPage.astro';
import { processRegistration } from '../lib/auth-pages';
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const result = await processRegistration({
  request: Astro.request,
  usuario: Astro.locals.usuario,
  locale,
  turnstileSiteKey: import.meta.env.PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY,
});
if ('redirect' in result) return Astro.redirect(result.redirect, result.status);
---

<RegistrationPage
  locale={locale}
  next={result.next}
  email={result.email}
  nombre={result.nombre}
  error={result.error}
  mensaje={result.mensaje}
  registroExitoso={result.registroExitoso}
  turnstileSiteKey={import.meta.env.PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY}
  googleClientId={import.meta.env.PUBLIC_GOOGLE_CLIENT_ID}
/>
