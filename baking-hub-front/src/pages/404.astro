---
import Layout from '../layouts/Layout.astro';
import { localizedPath } from '../lib/i18n';
Astro.response.status = 404;
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
---

<Layout titulo={locale === 'en' ? 'Not found' : 'No encontrado'} sidebar>
  <h2 class="section-title">{locale === 'en' ? 'We could not find what you were looking for' : 'No encontramos lo que buscabas'}</h2>
  <p class="estado-vacio">
    {locale === 'en' ? 'This page or product does not exist.' : 'La página o el producto no existe.'}{' '}
    <a href={localizedPath(locale, '/')}>{locale === 'en' ? 'Back to catalog' : 'Volver al catálogo'}</a>
  </p>
</Layout>
