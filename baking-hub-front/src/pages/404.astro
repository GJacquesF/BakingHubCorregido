---
import Layout from '../layouts/Layout.astro';
import { localizedPath, localizedText } from '../lib/i18n';
Astro.response.status = 404;
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
---

<Layout titulo={localizedText(locale, 'No encontrado')} sidebar>
  <h2 class="section-title">{localizedText(locale, 'No encontramos lo que buscabas')}</h2>
  <p class="estado-vacio">
    {localizedText(locale, 'La página o el producto no existe.')}{' '}
    <a href={localizedPath(locale, '/')}>{localizedText(locale, 'Volver al catálogo')}</a>
  </p>
</Layout>
