---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import WhyUs from '../components/WhyUs.astro';
import Alert from '../components/Alert.astro';
import { graphql, ApiError } from '../lib/graphql';
import { OBTENER_MENU } from '../lib/queries';
import { CATEGORIAS } from '../lib/categorias';
import type { Producto } from '../types';

const categoriaSolicitada = CATEGORIAS.find((c) => c === Astro.url.searchParams.get('categoria'));
if (categoriaSolicitada && categoriaSolicitada !== 'Todas') {
  return Astro.redirect(`/categoria/${encodeURIComponent(categoriaSolicitada)}`, 301);
}
const categoria = 'Todas';

let productos: Producto[] = [];
let error: string | null = null;
try {
  ({ productos } = await graphql<{ productos: Producto[] }>(OBTENER_MENU));
} catch (e) {
  error = e instanceof ApiError ? e.message : 'Error inesperado';
}

const filtrados = productos;
---

<Layout
  titulo={categoria === 'Todas' ? 'Postres artesanales' : `Postres ${categoria}`}
  descripcion="Explora el catálogo completo de postres artesanales de Baking Hub, horneados con ingredientes seleccionados."
  imagenLcp={productos[0]?.imagen}
  sidebar
  categoriaActiva={categoria}
>
  {categoria === 'Todas' && <Hero />}

  {categoria === 'Todas' ? <h2 class="section-title" data-i18n="home.catalog">Catálogo: {categoria}</h2> : <h1 class="section-title" data-i18n="home.catalog">Catálogo: {categoria}</h1>}

  {error && <Alert>Error de conexión: {error}</Alert>}

  {
    !error && (
      <div class="product-grid">
        {filtrados.length === 0 && <p class="estado-vacio" data-i18n="home.emptyCategory">No hay productos en esta categoría.</p>}
        {filtrados.map((p, index) => <ProductCard {...p} prioridad={index === 0} />)}
      </div>
    )
  }

  {categoria === 'Todas' && !error && <WhyUs />}
</Layout>

<style>
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 1.25rem;
  }
</style>
