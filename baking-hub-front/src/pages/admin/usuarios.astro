---
// Gestión de clientes: buscar, editar, suspender/reactivar y eliminar. Ruta protegida (solo admin).
import AdminLayout from '../../layouts/AdminLayout.astro';
import Alert from '../../components/Alert.astro';
import AdminPresenceUpdates from '../../components/AdminPresenceUpdates';
import { graphql } from '../../lib/graphql';
import { ACTUALIZAR_USUARIO, ADMIN_USUARIOS, CAMBIAR_ESTADO_USUARIO, ELIMINAR_USUARIO } from '../../lib/queries';
import { ErrorFormulario, mensajeError, texto } from '../../lib/admin';
import { precio } from '../../lib/format';
import { localizedPath } from '../../lib/i18n';
import type { UsuarioAdmin } from '../../types';

const token = Astro.locals.token;
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const AVISOS: Record<string, string> = {
  actualizado: 'Datos del cliente actualizados.',
  suspendido: 'Cuenta suspendida: el cliente ya no puede entrar ni comprar.',
  reactivado: 'Cuenta reactivada.',
  eliminado: 'Cliente eliminado. Sus pedidos se conservan en el historial.',
};
const AVISOS_EN: Record<string, string> = {
  actualizado: 'Customer details updated.',
  suspendido: 'Account suspended: this customer can no longer sign in or shop.',
  reactivado: 'Account reactivated.',
  eliminado: 'Customer removed. Their orders remain in the history.',
};
const avisoKey = Astro.url.searchParams.get('ok') ?? '';
const aviso = locale === 'en' ? AVISOS_EN[avisoKey] ?? null : AVISOS[avisoKey] ?? null;
const busqueda = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
const volver = (ok: string) => `${localizedPath(locale, '/admin/usuarios')}?ok=${ok}${busqueda ? `&q=${encodeURIComponent(busqueda)}` : ''}`;

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const accion = texto(datos, 'accion');
  const id = texto(datos, 'id');
  try {
    switch (accion) {
      case 'actualizar':
        await graphql(ACTUALIZAR_USUARIO, { id, nombre: texto(datos, 'nombre'), email: texto(datos, 'email') }, token);
        return Astro.redirect(volver('actualizado'), 303);
      case 'suspender':
      case 'reactivar':
        await graphql(CAMBIAR_ESTADO_USUARIO, { id, activo: accion === 'reactivar' }, token);
        return Astro.redirect(volver(accion === 'suspender' ? 'suspendido' : 'reactivado'), 303);
      case 'eliminar':
        await graphql(ELIMINAR_USUARIO, { id }, token);
        return Astro.redirect(volver('eliminado'), 303);
      default:
        throw new ErrorFormulario('Acción no reconocida.');
    }
  } catch (e) {
    error = mensajeError(e);
  }
}

let usuarios: UsuarioAdmin[] = [];
try {
  ({ adminUsuarios: usuarios } = await graphql<{ adminUsuarios: UsuarioAdmin[] }>(ADMIN_USUARIOS, { busqueda }, token));
} catch (e) {
  error ??= mensajeError(e);
}

const fecha = (iso: string) => new Date(iso).toLocaleDateString(locale === 'en' ? 'en-US' : 'es-MX', { dateStyle: 'medium' });
---

<AdminLayout titulo={locale === 'en' ? 'Customers' : 'Clientes'} seccion="usuarios">
  <h2 class="admin-titulo">{locale === 'en' ? 'Customers' : 'Clientes'}</h2>
  <p class="admin-subtitulo">
    {locale === 'en' ? 'Review customer accounts, update their details, or suspend access.' : 'Consulta las cuentas de clientes, corrige sus datos o suspende el acceso.'}
  </p>
  <AdminPresenceUpdates client:load />

  {aviso && <p class="mensaje-exito" role="status">{aviso}</p>}
  {error && <Alert>{error}</Alert>}

  <form method="GET" class="buscador" role="search">
    <input
      type="search"
      name="q"
      value={busqueda}
      placeholder={locale === 'en' ? 'Search by name or email…' : 'Buscar por nombre o correo…'}
      aria-label={locale === 'en' ? 'Search customers' : 'Buscar cliente'}
    />
    <button class="btn-admin" type="submit">{locale === 'en' ? 'Search' : 'Buscar'}</button>
    {busqueda && <a class="btn-admin sec" href={localizedPath(locale, '/admin/usuarios')}>{locale === 'en' ? 'Clear' : 'Limpiar'}</a>}
  </form>

  {
    usuarios.length === 0 && !error && (
      <p class="estado-vacio">
        {busqueda
          ? locale === 'en' ? 'No customers match your search.' : 'Ningún cliente coincide con tu búsqueda.'
          : locale === 'en' ? 'No customers have registered yet.' : 'Todavía no hay clientes registrados.'}
      </p>
    )
  }

  {
    usuarios.length > 0 && (
      <div class="tabla-wrap">
        <table class="tabla-admin">
          <thead>
            <tr>
              <th>{locale === 'en' ? 'Customer' : 'Cliente'}</th>
              <th>{locale === 'en' ? 'Registered' : 'Registro'}</th>
              <th class="num">{locale === 'en' ? 'Orders' : 'Pedidos'}</th>
              <th class="num">{locale === 'en' ? 'Total spent' : 'Total pagado'}</th>
              <th>{locale === 'en' ? 'Status' : 'Estado'}</th>
              <th>{locale === 'en' ? 'Online' : 'Online'}</th>
              <th>{locale === 'en' ? 'Actions' : 'Acciones'}</th>
            </tr>
          </thead>
          <tbody>
            {usuarios.map((u) => (
              <tr class:list={{ suspendido: !u.activo }}>
                <td>
                  <strong>{u.nombre}</strong>
                  <br />
                  <small>{u.email}</small>
                </td>
                <td>{fecha(u.creado)}</td>
                <td class="num">{u.pedidos}</td>
                <td class="num">{precio(u.totalComprado)}</td>
                <td>
                  <span class={`badge ${u.activo ? 'badge-ok' : 'badge-error'}`}>
                    {u.activo ? locale === 'en' ? 'Active' : 'Activo' : locale === 'en' ? 'Suspended' : 'Suspendido'}
                  </span>
                </td>
                <td>
                  <span class:list={['presencia-usuario', u.online ? 'en-linea' : 'fuera-linea']}>
                    {u.online ? locale === 'en' ? 'Online' : 'En línea' : locale === 'en' ? 'Offline' : 'Desconectado'}
                  </span>
                </td>
                <td>
                  <div class="acciones">
                    <div class="fila">
                      <form
                        method="POST"
                        data-confirmar={u.activo
                          ? locale === 'en'
                            ? `Suspend ${u.nombre}'s account? They will not be able to sign in or shop.`
                            : `¿Suspender la cuenta de ${u.nombre}? No podrá entrar ni comprar.`
                          : undefined}
                      >
                        <input type="hidden" name="accion" value={u.activo ? 'suspender' : 'reactivar'} />
                        <input type="hidden" name="id" value={u.id} />
                        <button class="btn-admin sec" type="submit">
                          {u.activo ? locale === 'en' ? 'Suspend' : 'Suspender' : locale === 'en' ? 'Reactivate' : 'Reactivar'}
                        </button>
                      </form>
                      <form
                        method="POST"
                        data-confirmar={locale === 'en'
                          ? `Remove ${u.nombre}? This action cannot be undone.`
                          : `¿Eliminar a ${u.nombre}? Esta acción no se puede deshacer.`}
                      >
                        <input type="hidden" name="accion" value="eliminar" />
                        <input type="hidden" name="id" value={u.id} />
                        <button class="btn-admin peligro" type="submit">
                          {locale === 'en' ? 'Remove' : 'Eliminar'}
                        </button>
                      </form>
                    </div>
                    <details>
                      <summary>{locale === 'en' ? 'Edit details' : 'Editar datos'}</summary>
                      <form method="POST">
                        <input type="hidden" name="accion" value="actualizar" />
                        <input type="hidden" name="id" value={u.id} />
                        <div class="campo-admin">
                          <label for={`u-nombre-${u.id}`}>{locale === 'en' ? 'Name' : 'Nombre'}</label>
                          <input id={`u-nombre-${u.id}`} name="nombre" value={u.nombre} minlength="2" maxlength="100" required />
                        </div>
                        <div class="campo-admin">
                          <label for={`u-email-${u.id}`}>{locale === 'en' ? 'Email' : 'Correo'}</label>
                          <input id={`u-email-${u.id}`} name="email" type="email" value={u.email} maxlength="254" required />
                        </div>
                        <button class="btn-admin" type="submit">
                          {locale === 'en' ? 'Save' : 'Guardar'}
                        </button>
                      </form>
                    </details>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
