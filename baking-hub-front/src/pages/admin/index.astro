---
// Resumen del panel. La ruta /admin está protegida en src/middleware.ts (solo rol admin).
import AdminLayout from '../../layouts/AdminLayout.astro';
import Alert from '../../components/Alert.astro';
import AdminLiveUpdates from '../../components/AdminLiveUpdates';
import { graphql, ApiError } from '../../lib/graphql';
import { ADMIN_RESUMEN } from '../../lib/queries';
import { localizedMessage, localizedPath, localizedText } from '../../lib/i18n';
import { precio } from '../../lib/format';
import type { ResumenAdmin } from '../../types';

let resumen: ResumenAdmin | null = null;
const locale = Astro.locals.locale;
let error: string | null = null;
try {
  ({ adminResumen: resumen } = await graphql<{ adminResumen: ResumenAdmin }>(ADMIN_RESUMEN, {}, Astro.locals.token));
} catch (e) {
  error = localizedMessage(e instanceof ApiError ? e.message : 'Error inesperado', locale);
}
---

<AdminLayout titulo={localizedText(locale, 'Resumen')} seccion="resumen">
  <h2 class="admin-titulo">{localizedText(locale, 'Resumen de la tienda')}</h2>
  <p class="admin-subtitulo">
    {localizedText(locale, 'Hola')}, {Astro.locals.usuario?.nombre}.{' '}
    {localizedText(locale, 'Esto es lo más importante de hoy.')}
  </p>
  <AdminLiveUpdates client:load />

  {error && <Alert>{error}</Alert>}

  {
    resumen && (
      <>
        <div class="stats">
          <div class="stat">
            <span class="stat-valor">{precio(resumen.ventas)}</span>
            <span class="stat-texto">{localizedText(locale, 'Ventas cobradas')}</span>
          </div>
          <div class="stat">
            <span class="stat-valor">{resumen.pedidosPagados}</span>
            <span class="stat-texto">{localizedText(locale, 'Pedidos pagados')}</span>
          </div>
          <div class="stat">
            <span class="stat-valor">{resumen.pedidosPendientes}</span>
            <span class="stat-texto">{localizedText(locale, 'Pedidos pendientes de pago')}</span>
          </div>
          <a class="stat" href={localizedPath(locale, '/admin/inventario')}>
            <span class="stat-valor">{resumen.productos}</span>
            <span class="stat-texto">{localizedText(locale, 'Productos en catálogo')}</span>
          </a>
          <a class:list={['stat', { alerta: resumen.sinStock > 0 }]} href={localizedPath(locale, '/admin/inventario')}>
            <span class="stat-valor">{resumen.sinStock}</span>
            <span class="stat-texto">{localizedText(locale, 'Productos agotados')}</span>
          </a>
          <a class="stat" href={localizedPath(locale, '/admin/inventario')}>
            <span class="stat-valor">{resumen.stockBajo}</span>
            <span class="stat-texto">{localizedText(locale, 'Con stock bajo (5 o menos)')}</span>
          </a>
          <a class="stat" href={localizedPath(locale, '/admin/usuarios')}>
            <span class="stat-valor">{resumen.clientes}</span>
            <span class="stat-texto">{localizedText(locale, 'Clientes registrados')}</span>
          </a>
          <a class="stat" href={localizedPath(locale, '/admin/usuarios')}>
            <span class="stat-valor">{resumen.clientesSuspendidos}</span>
            <span class="stat-texto">{localizedText(locale, 'Cuentas suspendidas')}</span>
          </a>
        </div>

        <div class="admin-bloque">
          <h3>{localizedText(locale, 'Accesos rápidos')}</h3>
          <p style="display:flex;gap:0.6rem;flex-wrap:wrap;margin:0">
            <a class="btn-admin" href={localizedPath(locale, '/admin/inventario')}>{localizedText(locale, 'Agregar inventario')}</a>
            <a class="btn-admin sec" href={localizedPath(locale, '/admin/usuarios')}>{localizedText(locale, 'Gestionar clientes')}</a>
          </p>
        </div>
      </>
    )
  }
</AdminLayout>
