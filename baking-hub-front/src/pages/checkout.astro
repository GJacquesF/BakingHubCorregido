---
// Esta ruta está protegida por src/middleware.ts: solo entran usuarios con sesión.
import Layout from '../layouts/Layout.astro';
import CheckoutView from '../components/CheckoutView';
import Alert from '../components/Alert.astro';
import { graphql, ApiError } from '../lib/graphql';
import { CONFIG_PAGOS, PUNTOS_ENTREGA } from '../lib/queries';
import { localizedMessage, localizedText } from '../lib/i18n';
import type { ConfigPagos, PuntoEntrega } from '../types';

const usuario = Astro.locals.usuario!;
const locale = Astro.locals.locale;

let config: ConfigPagos | null = null;
let puntos: PuntoEntrega[] = [];
let error: string | null = null;
try {
  ({ configPagos: config } = await graphql<{ configPagos: ConfigPagos }>(CONFIG_PAGOS));
  ({ puntosEntrega: puntos } = await graphql<{ puntosEntrega: PuntoEntrega[] }>(PUNTOS_ENTREGA, {}, Astro.locals.token));
} catch (e) {
  error = localizedMessage(e instanceof ApiError ? e.message : 'Error inesperado', locale);
}
---

<Layout titulo="Checkout" sidebar>
  <script is:inline src="https://sdk.mercadopago.com/js/v2" defer></script>
  <h2 class="section-title">{localizedText(locale, 'Finalizar compra')}</h2>
  {error && (
    <Alert>{localizedText(locale, 'No pudimos cargar los métodos de pago:')}{' '}{error}</Alert>
  )}
  {
    config && (
      <CheckoutView client:only="react" config={config} puntos={puntos} usuario={{ nombre: usuario.nombre, email: usuario.email }} locale={locale}>
        <p slot="fallback" class="estado-vacio">
          {localizedText(locale, 'Cargando tu orden…')}
        </p>
      </CheckoutView>
    )
  }
</Layout>
