---
import Layout from '../layouts/Layout.astro';
import CartView from '../components/CartView';
---

<Layout titulo={Astro.currentLocale === 'en' ? 'Cart' : 'Carrito'} sidebar>
  <h2 class="section-title">
    {Astro.currentLocale === 'en' ? 'Your shopping cart' : 'Tu carrito de compras'}
  </h2>
  <CartView client:only="react">
    <p slot="fallback" class="estado-vacio">
      {Astro.currentLocale === 'en' ? 'Loading your cart…' : 'Cargando tu carrito…'}
    </p>
  </CartView>
</Layout>
