---
import Layout from '../layouts/Layout.astro';
import CartView from '../components/CartView';
import { localizedText } from '../lib/i18n';

const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
---

<Layout titulo={localizedText(locale, 'Carrito')} sidebar>
  <h2 class="section-title">
    {localizedText(locale, 'Tu carrito de compras')}
  </h2>
  <CartView client:only="react">
    <p slot="fallback" class="estado-vacio">
      {localizedText(locale, 'Cargando tu carrito…')}
    </p>
  </CartView>
</Layout>
