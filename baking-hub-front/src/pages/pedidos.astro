---
// Esta ruta está protegida por src/middleware.ts: solo entran usuarios con sesión.
import Layout from '../layouts/Layout.astro';
import PedidoCard from '../components/PedidoCard.astro';
import Alert from '../components/Alert.astro';
import { graphql, ApiError } from '../lib/graphql';
import { MIS_PEDIDOS } from '../lib/queries';
import { localizedMessage, localizedPath } from '../lib/i18n';
import type { Pedido } from '../types';

const nuevo = Astro.url.searchParams.get('nuevo');
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';

let pedidos: Pedido[] = [];
let error: string | null = null;
try {
  ({ misPedidos: pedidos } = await graphql<{ misPedidos: Pedido[] }>(MIS_PEDIDOS, {}, Astro.locals.token));
} catch (e) {
  error = localizedMessage(e instanceof ApiError ? e.message : 'Error inesperado', locale);
}
---

<Layout titulo={locale === 'en' ? 'My orders' : 'Mis pedidos'} sidebar>
  <h2 class="section-title">{locale === 'en' ? 'My orders' : 'Mis pedidos'}</h2>

  {nuevo && !error && (
    <p class="exito" role="status">
      {locale === 'en' ? `Order created successfully! Your order number is #${nuevo}.` : `¡Pedido creado con éxito! Tu número de pedido es #${nuevo}.`}
    </p>
  )}
  {error && <Alert>{error}</Alert>}

  {
    !error && pedidos.length === 0 && (
      <p class="estado-vacio">
        {locale === 'en' ? 'You do not have any orders yet.' : 'Todavía no tienes pedidos.'}{' '}
        <a href={localizedPath(locale, '/')}>{locale === 'en' ? 'View catalog' : 'Ver el catálogo'}</a>
      </p>
    )
  }

  <div class="lista">
    {pedidos.map((p) => <PedidoCard pedido={p} destacado={p.id === nuevo} />)}
  </div>
</Layout>

<style>
  .lista {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .exito {
    background: var(--success-surface);
    border: 1px solid var(--success-border);
    color: var(--success-text);
    padding: 0.9rem 1rem;
    border-radius: 8px;
    max-width: 560px;
  }
</style>
