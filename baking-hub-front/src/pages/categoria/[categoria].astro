---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Alert from '../../components/Alert.astro';
import { graphql, ApiError } from '../../lib/graphql';
import { OBTENER_MENU } from '../../lib/queries';
import { CATEGORIAS, obtenerCategoria } from '../../lib/categorias';
import { localizedMessage, localizedPath, localizedText } from '../../lib/i18n';
import type { Producto } from '../../types';

const nombreCategoria = decodeURIComponent(Astro.params.categoria ?? '');
const locale = Astro.locals.locale;
if (!CATEGORIAS.includes(nombreCategoria as (typeof CATEGORIAS)[number]) || nombreCategoria === 'Todas') {
  return Astro.rewrite(localizedPath(locale, '/404'));
}

let productos: Producto[] = [];
let error: string | null = null;
try {
  ({ productos } = await graphql<{ productos: Producto[] }>(OBTENER_MENU));
} catch (e) {
  error = localizedMessage(e instanceof ApiError ? e.message : 'Error inesperado', locale);
}

const filtrados = productos.filter((producto) => obtenerCategoria(producto.nombre) === nombreCategoria);
---

<Layout
  titulo={localizedText(locale, 'Postres {categoria}', { categoria: nombreCategoria })}
  descripcion={localizedText(
    locale,
    'Explora postres de {categoria} de Baking Hub, horneados con ingredientes seleccionados.',
    { categoria: nombreCategoria },
  )}
  imagenLcp={filtrados[0]?.imagen}
  sidebar
  categoriaActiva={nombreCategoria}
>
  <h1 class="section-title">{localizedText(locale, 'Postres de')} {nombreCategoria}</h1>
  {error && <Alert>{localizedText(locale, 'Error de conexión:')}{' '}{error}</Alert>}
  {
    !error && (
      <div class="product-grid">
        {filtrados.length === 0 && (
          <p class="estado-vacio">{localizedText(locale, 'No hay productos en esta categoría.')}</p>
        )}
        {filtrados.map((producto, index) => <ProductCard {...producto} prioridad={index === 0} />)}
      </div>
    )
  }
</Layout>

<style>
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 1.25rem;
  }
</style>