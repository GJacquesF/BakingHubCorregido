# Copia este archivo a ".env". Solo lo lee el servidor de Astro (salvo las variables PUBLIC_).
# URL del backend GraphQL (backend-practica-6-2).
# Local: http://localhost:4000/   Producción (Netlify): la URL de Render, p. ej. https://baking-hub-backend.onrender.com/
GRAPHQL_URL=http://localhost:4000/
# WebSocket GraphQL usado por el servidor Astro para el panel admin.
# Local: ws://localhost:4000/subscriptions   Producción: wss://baking-hub-backend.onrender.com/subscriptions
GRAPHQL_WS_URL=ws://localhost:4000/subscriptions
# Solo en Netlify: 9000 (las funciones con streaming se cortan a los 10 s). Local: déjalo en 0 o quítalo.
# SSE_MAX_MS=9000

# Mercado Pago: clave PÚBLICA (Tus integraciones -> Credenciales; empieza con APP_USR- o TEST-). Es segura para el navegador.
# Debe corresponder al MISMO entorno que MP_ACCESS_TOKEN del backend (prueba con prueba, producción con producción).
# Se incrusta al compilar: después de cambiarla reinicia `npm run dev` (en Netlify, vuelve a desplegar).
# Déjala vacía mientras el backend esté en MP_MODO=simulado.
PUBLIC_MP_PUBLIC_KEY=

# ---------------------------------------------------------------------------------------
# Mapa de entregas (Leaflet + OpenStreetMap). Todo es OPCIONAL: sin configurar nada funciona.
# Son variables PUBLIC_: llegan al navegador, no pongas secretos aquí. Reinicia `npm run dev` tras cambiarlas.
# ---------------------------------------------------------------------------------------
# Centro y zoom iniciales del mapa cuando aún no hay puntos (por defecto: Ciudad de México).
# PUBLIC_MAPA_LAT=19.4326
# PUBLIC_MAPA_LNG=-99.1332
# PUBLIC_MAPA_ZOOM=12
# Países donde buscar direcciones (códigos ISO separados por coma; vacío = todo el mundo). Por defecto: mx
# PUBLIC_MAPA_PAISES=mx
# Proveedor de mosaicos. Por defecto OpenStreetMap (gratis, para uso moderado). Si esperas mucho tráfico,
# usa MapTiler, Stadia, Mapbox, etc. con su URL y atribución, p. ej.:
# PUBLIC_MAPA_TILES_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=TU_CLAVE
# PUBLIC_MAPA_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
